<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- 텍스트 스타일 -->
    <style name="TextAppearance.Label" parent="TextAppearance.AppCompat">
        <item name="android:textSize">@dimen/text_size_medium</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@android:color/black</item>
    </style>

    <style name="TextAppearance.NoteTitle" parent="TextAppearance.AppCompat">
        <item name="android:textSize">@dimen/text_size_large</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@android:color/black</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
    </style>

    <style name="TextAppearance.NoteContent" parent="TextAppearance.AppCompat">
        <item name="android:textSize">@dimen/text_size_normal</item>
        <item name="android:textColor">#666666</item>
        <item name="android:maxLines">2</item>
        <item name="android:ellipsize">end</item>
    </style>

    <style name="TextAppearance.NoteDate" parent="TextAppearance.AppCompat">
        <item name="android:textSize">@dimen/text_size_small</item>
        <item name="android:textColor">#999999</item>
    </style>

    <style name="TextAppearance.EmptyState" parent="TextAppearance.AppCompat">
        <item name="android:textSize">@dimen/text_size_medium</item>
        <item name="android:textColor">#999999</item>
        <item name="android:gravity">center</item>
    </style>

    <!-- EditText 스타일 -->
    <style name="AppEditText" parent="Widget.AppCompat.EditText">
        <item name="android:padding">@dimen/padding_edit_text</item>
        <item name="android:background">@android:drawable/editbox_background</item>
    </style>

    <style name="AppEditText.Title" parent="AppEditText">
        <item name="android:hint">메모 제목을 입력하세요</item>
        <item name="android:inputType">text</item>
        <item name="android:maxLines">1</item>
    </style>

    <style name="AppEditText.Content" parent="AppEditText">
        <item name="android:hint">메모 내용을 입력하세요</item>
        <item name="android:inputType">textMultiLine</item>
        <item name="android:gravity">top|start</item>
        <item name="android:minHeight">@dimen/edit_text_content_height</item>
    </style>

    <style name="AppEditText.Search" parent="AppEditText">
        <item name="android:hint">메모 검색...</item>
        <item name="android:background">@android:color/white</item>
        <item name="android:drawableStart">@android:drawable/ic_menu_search</item>
        <item name="android:drawablePadding">@dimen/spacing_small</item>
    </style>

    <!-- Button 스타일 -->
    <style name="AppButton" parent="Widget.MaterialComponents.Button">
        <item name="android:padding">@dimen/padding_button</item>
        <item name="android:textSize">@dimen/text_size_medium</item>
    </style>

    <style name="AppButton.Outlined" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="android:textSize">@dimen/text_size_normal</item>
    </style>

    <!-- CheckBox 스타일 -->
    <style name="AppCheckBox">
        <item name="android:textSize">@dimen/text_size_medium</item>
    </style>

    <!-- Card 스타일WWS -->
    <style name="AppCardView" parent="Widget.MaterialComponents.CardView">
        <item name="cardCornerRadius">@dimen/card_corner_radius</item>
        <item name="cardElevation">@dimen/card_elevation</item>
        <item name="android:layout_margin">@dimen/margin_card</item>
    </style>

    <!-- Container 스타일 -->
    <style name="AppContainer">
        <item name="android:padding">@dimen/padding_standard</item>
    </style>

    <style name="AppContainerCard">
        <item name="android:padding">@dimen/padding_card</item>
    </style>
</resources>