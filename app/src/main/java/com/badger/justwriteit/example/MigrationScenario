// ========================================
// 마이그레이션 흐름도
// ========================================

/*
버전 1 DB
    │
    │ app 업데이트 감지
    │
    ├─→ MIGRATION_1_2.migrate() 실행
    │   └─→ ALTER TABLE notes ADD COLUMN category...
    │
버전 2 DB
    │
    │ 다시 app 업데이트
    │
    ├─→ MIGRATION_2_3.migrate() 실행
    │   ├─→ ALTER TABLE notes ADD COLUMN updatedAt...
    │   ├─→ UPDATE notes SET updatedAt = createdAt
    │   └─→ ALTER TABLE notes ADD COLUMN isImportant...
    │
버전 3 DB
    │
    ✅ 최신 상태!
*/

// ========================================
// 개발자를 위한 디버깅 팁
// ========================================

/**
 * 마이그레이션 로그 확인
 */
class NoteDatabase : RoomDatabase() {
    companion object {
        fun getDatabase(context: Context): NoteDatabase {
            return Room.databaseBuilder(context, NoteDatabase::class.java, "note_db")
                .addMigrations(MIGRATION_1_2, MIGRATION_2_3)
                // 마이그레이션 성공/실패 로그
                .setQueryCallback({ sqlQuery, bindArgs ->
                    Log.d("RoomQuery", "SQL: $sqlQuery, Args: $bindArgs")
                }, Executors.newSingleThreadExecutor())
                .build()
        }
    }
}

/**
 * 강제로 특정 버전으로 시작하기 (테스트용)
 */
fun testMigration(context: Context) {
    // 기존 DB 삭제
    context.deleteDatabase("note_db")

    // 버전 1로 시작
    val dbV1 = Room.databaseBuilder(context, NoteDatabase::class.java, "note_db")
        .fallbackToDestructiveMigration()
        .build()

    // 데이터 삽입
    // ...

    dbV1.close()

    // 버전 3로 업그레이드 테스트
    val dbV3 = Room.databaseBuilder(context, NoteDatabase::class.java, "note_db")
        .addMigrations(MIGRATION_1_2, MIGRATION_2_3)
        .build()

    // 데이터 확인
}

