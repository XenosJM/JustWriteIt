// 실전 추천 코드
// ========================================

/**
 * 프로젝트에서 사용할 유틸리티 클래스
 */
object DialogUtils {

    /**
     * 간단한 확인 다이얼로그
     */
    fun showConfirmDialog(
        context: android.content.Context,
        title: String,
        message: String,
        onConfirm: () -> Unit
    ) {
        MaterialAlertDialogBuilder(context)
            .setTitle(title)
            .setMessage(message)
            .setPositiveButton("확인") { _, _ -> onConfirm() }
            .setNegativeButton("취소", null)
            .show()
    }

    /**
     * 정보 다이얼로그
     */
    fun showInfoDialog(
        context: android.content.Context,
        title: String,
        message: String
    ) {
        MaterialAlertDialogBuilder(context)
            .setTitle(title)
            .setMessage(message)
            .setPositiveButton("확인", null)
            .show()
    }

    /**
     * 삭제 확인 다이얼로그
     */
    fun showDeleteDialog(
        context: android.content.Context,
        itemName: String,
        onDelete: () -> Unit
    ) {
        MaterialAlertDialogBuilder(context)
            .setTitle("삭제 확인")
            .setMessage("'$itemName'을(를) 삭제하시겠습니까?")
            .setIcon(android.R.drawable.ic_dialog_alert)
            .setPositiveButton("삭제") { _, _ -> onDelete() }
            .setNegativeButton("취소", null)
            .show()
    }
}

// 사용 예제
class ExampleUsage : AppCompatActivity() {
    fun example() {
        DialogUtils.showDeleteDialog(
            context = this,
            itemName = "회의록"
        ) {
            // 삭제 로직
            Toast.makeText(this, "삭제됨", Toast.LENGTH_SHORT).show()
        }
    }
}