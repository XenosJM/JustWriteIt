/**
 * Material Design 3를 따르는 다이얼로그
 * AlertDialog보다 더 현대적인 디자인
 *
 * build.gradle 추가 필요:
 * implementation 'com.google.android.material:material:1.11.0'
 */
class MaterialDialogExamples : AppCompatActivity() {

    /**
     * 기본 Material Dialog
     * AlertDialog와 사용법 거의 동일
     */
    fun showBasicMaterialDialog() {
        MaterialAlertDialogBuilder(this)
            .setTitle("Material Dialog")
            .setMessage("Material Design 3 스타일의 다이얼로그입니다")
            .setPositiveButton("확인") { _, _ ->
                // 클릭 처리
            }
            .setNegativeButton("취소", null)
            .show()
    }

    /**
     * 아이콘 포함
     */
    fun showDialogWithIcon() {
        MaterialAlertDialogBuilder(this)
            .setTitle("삭제 확인")
            .setMessage("정말 삭제하시겠습니까?")
            .setIcon(android.R.drawable.ic_dialog_alert)  // 아이콘 추가
            .setPositiveButton("삭제") { _, _ ->
                // 삭제 로직
            }
            .setNegativeButton("취소", null)
            .show()
    }

    /**
     * 배경 커스텀 (Material 테마)
     */
    fun showThemedDialog() {
        MaterialAlertDialogBuilder(this)
            // Material 컴포넌트 테마 적용
            .setTitle("테마 적용 Dialog")
            .setMessage("Material You 디자인이 적용됩니다")
            .setPositiveButton("확인", null)
            .setBackground(getDrawable(android.R.drawable.dialog_holo_light_frame))
            .show()
    }

    /**
     * 단일 선택 리스트
     */
    fun showSingleChoiceDialog() {
        val items = arrayOf("작게", "보통", "크게")
        var selectedIndex = 1

        MaterialAlertDialogBuilder(this)
            .setTitle("글자 크기")
            .setSingleChoiceItems(items, selectedIndex) { _, which ->
                selectedIndex = which
            }
            .setPositiveButton("확인") { _, _ ->
                Toast.makeText(this, "${items[selectedIndex]} 선택됨", Toast.LENGTH_SHORT).show()
            }
            .setNegativeButton("취소", null)
            .show()
    }

    /**
     * 다중 선택 리스트
     */
    fun showMultiChoiceDialog() {
        val items = arrayOf("알림", "진동", "소리")
        val checkedItems = booleanArrayOf(true, false, true)

        MaterialAlertDialogBuilder(this)
            .setTitle("알림 설정")
            .setMultiChoiceItems(items, checkedItems) { _, which, isChecked ->
                checkedItems[which] = isChecked
            }
            .setPositiveButton("확인") { _, _ ->
                val selected = items.filterIndexed { index, _ -> checkedItems[index] }
                Toast.makeText(this, "선택: ${selected.joinToString()}", Toast.LENGTH_SHORT).show()
            }
            .setNegativeButton("취소", null)
            .show()
    }
}

