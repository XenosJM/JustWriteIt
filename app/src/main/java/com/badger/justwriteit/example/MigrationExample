

import androidx.room.migration.Migration
import androidx.sqlite.db.SupportSQLiteDatabase

/**
 * 데이터베이스 마이그레이션 완전 가이드
 * 
 * 마이그레이션 = 데이터베이스 버전 업그레이드 전략
 * 사용자 데이터를 보존하면서 스키마를 변경하는 방법
 */

// ========================================
// 예제 1: 새 컬럼 추가 (버전 1 -> 2)
// ========================================

/**
 * 시나리오: 메모에 "카테고리" 기능을 추가하고 싶음
 * 
 * 변경 전 (Version 1):
 * CREATE TABLE notes (
 *     id INTEGER PRIMARY KEY,
 *     title TEXT,
 *     content TEXT,
 *     created_at INTEGER
 * )
 * 
 * 변경 후 (Version 2):
 * CREATE TABLE notes (
 *     id INTEGER PRIMARY KEY,
 *     title TEXT,
 *     content TEXT,
 *     created_at INTEGER,
 *     category TEXT  ← 새로 추가!
 * )
 */
val MIGRATION_1_2 = object : Migration(1, 2) {
    override fun migrate(database: SupportSQLiteDatabase) {
        // SQL 명령어로 테이블 구조 변경
        database.execSQL(
            """
            ALTER TABLE notes 
            ADD COLUMN category TEXT DEFAULT 'general' NOT NULL
            """.trimIndent()
        )
        
        // 설명:
        // - ALTER TABLE: 테이블 구조 변경
        // - ADD COLUMN: 새 컬럼 추가
        // - DEFAULT 'general': 기존 데이터의 기본값 (중요!)
        // - NOT NULL: null 불가 (기본값 있으므로 안전)
    }
}

// ========================================
// 예제 2: 컬럼 이름 변경 (버전 2 -> 3)
// ========================================

/**
 * 시나리오: "created_at"을 "createdDate"로 변경
 * 
 * SQLite는 컬럼 이름 변경을 직접 지원하지 않음!
 * 우회 방법: 새 테이블 생성 → 데이터 복사 → 기존 테이블 삭제
 */
val MIGRATION_2_3 = object : Migration(2, 3) {
    override fun migrate(database: SupportSQLiteDatabase) {
        // 1단계: 새 테이블 생성
        database.execSQL(
            """
            CREATE TABLE notes_new (
                id INTEGER PRIMARY KEY NOT NULL,
                title TEXT NOT NULL,
                content TEXT NOT NULL,
                createdDate INTEGER NOT NULL,
                category TEXT NOT NULL DEFAULT 'general'
            )
            """.trimIndent()
        )
        
        // 2단계: 기존 데이터 복사
        database.execSQL(
            """
            INSERT INTO notes_new (id, title, content, createdDate, category)
            SELECT id, title, content, created_at, category
            FROM notes
            """.trimIndent()
        )
        
        // 3단계: 기존 테이블 삭제
        database.execSQL("DROP TABLE notes")
        
        // 4단계: 새 테이블 이름 변경
        database.execSQL("ALTER TABLE notes_new RENAME TO notes")
    }
}

// ========================================
// 예제 3: 새 테이블 추가 (버전 3 -> 4)
// ========================================

/**
 * 시나리오: "태그" 기능 추가 - 새로운 tags 테이블 생성
 */
val MIGRATION_3_4 = object : Migration(3, 4) {
    override fun migrate(database: SupportSQLiteDatabase) {
        // 새 테이블 생성
        database.execSQL(
            """
            CREATE TABLE tags (
                id INTEGER PRIMARY KEY AUTOINCREMENT NOT NULL,
                name TEXT NOT NULL UNIQUE,
                color TEXT NOT NULL
            )
            """.trimIndent()
        )
        
        // 메모-태그 관계 테이블 (다대다 관계)
        database.execSQL(
            """
            CREATE TABLE note_tag_cross_ref (
                noteId INTEGER NOT NULL,
                tagId INTEGER NOT NULL,
                PRIMARY KEY(noteId, tagId),
                FOREIGN KEY(noteId) REFERENCES notes(id) ON DELETE CASCADE,
                FOREIGN KEY(tagId) REFERENCES tags(id) ON DELETE CASCADE
            )
            """.trimIndent()
        )
        
        // 인덱스 추가 (검색 성능 향상)
        database.execSQL(
            "CREATE INDEX index_note_tag_cross_ref_noteId ON note_tag_cross_ref(noteId)"
        )
        database.execSQL(
            "CREATE INDEX index_note_tag_cross_ref_tagId ON note_tag_cross_ref(tagId)"
        )
    }
}

// ========================================
// 예제 4: 컬럼 삭제 (버전 4 -> 5)
// ========================================

/**
 * 시나리오: "category" 컬럼 삭제 (tags로 대체)
 * SQLite는 DROP COLUMN을 지원하지 않음 (Android 11+ 제외)
 */
val MIGRATION_4_5 = object : Migration(4, 5) {
    override fun migrate(database: SupportSQLiteDatabase) {
        // 방법 1: 새 테이블 생성 방식 (안전, 권장)
        database.execSQL(
            """
            CREATE TABLE notes_new (
                id INTEGER PRIMARY KEY NOT NULL,
                title TEXT NOT NULL,
                content TEXT NOT NULL,
                createdDate INTEGER NOT NULL,
                updated_at INTEGER NOT NULL
            )
            """.trimIndent()
        )
        
        database.execSQL(
            """
            INSERT INTO notes_new (id, title, content, createdDate, updated_at)
            SELECT id, title, content, createdDate, updated_at
            FROM notes
            """.trimIndent()
        )
        
        database.execSQL("DROP TABLE notes")
        database.execSQL("ALTER TABLE notes_new RENAME TO notes")
        
        // 방법 2: Android 11+ (API 30+)에서는 직접 삭제 가능
        // database.execSQL("ALTER TABLE notes DROP COLUMN category")
    }
}

