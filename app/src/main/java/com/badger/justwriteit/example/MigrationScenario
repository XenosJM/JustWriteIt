/*
실제 테이블 구조:
┌────┬────────────┬──────────┬────────────┐
│ id │   title    │ content  │ createdAt  │
├────┼────────────┼──────────┼────────────┤
│ 1  │ 할일       │ 청소하기  │ 1234567890 │
│ 2  │ 쇼핑       │ 우유 사기 │ 1234567891 │
└────┴────────────┴──────────┴────────────┘
*/

// ========================================
// 📱 버전 2.0 (카테고리 기능 추가)
// ========================================

package com.example.datastoragedemo.v2

import androidx.room.*
import androidx.room.migration.Migration
import androidx.sqlite.db.SupportSQLiteDatabase

// 카테고리 필드 추가
@Entity(tableName = "notes")
data class Note(
    @PrimaryKey(autoGenerate = true)
    val id: Int = 0,
    val title: String,
    val content: String,
    val createdAt: Long = System.currentTimeMillis(),
    val category: String = "일반"  // ← 새 필드!
)

// 버전을 2로 증가
@Database(entities = [Note::class], version = 2)
abstract class NoteDatabase : RoomDatabase() {
    abstract fun noteDao(): NoteDao

    companion object {
        // 마이그레이션 정의
        val MIGRATION_1_2 = object : Migration(1, 2) {
            override fun migrate(db: SupportSQLiteDatabase) {
                // 기존 메모들에 "일반" 카테고리 자동 할당
                db.execSQL(
                    "ALTER TABLE notes ADD COLUMN category TEXT NOT NULL DEFAULT '일반'"
                )
            }
        }

        fun getDatabase(context: Context): NoteDatabase {
            return Room.databaseBuilder(context, NoteDatabase::class.java, "note_db")
                .addMigrations(MIGRATION_1_2)  // 마이그레이션 추가!
                .build()
        }
    }
}

/*
업그레이드 후 테이블:
┌────┬────────────┬──────────┬────────────┬──────────┐
│ id │   title    │ content  │ createdAt  │ category │
├────┼────────────┼──────────┼────────────┼──────────┤
│ 1  │ 할일       │ 청소하기  │ 1234567890 │ 일반     │ ← 자동 추가
│ 2  │ 쇼핑       │ 우유 사기 │ 1234567891 │ 일반     │ ← 자동 추가
│ 3  │ 회의       │ 내일 2시 │ 1234567892 │ 업무     │ ← 새 메모
└────┴────────────┴──────────┴────────────┴──────────┘
*/

// ========================================
// 📱 버전 3.0 (중요도 + 수정일 추가)
// ========================================

package com.example.datastoragedemo.v3

import androidx.room.*
import androidx.room.migration.Migration
import androidx.sqlite.db.SupportSQLiteDatabase

@Entity(tableName = "notes")
data class Note(
    @PrimaryKey(autoGenerate = true)
    val id: Int = 0,
    val title: String,
    val content: String,
    val createdAt: Long = System.currentTimeMillis(),
    val updatedAt: Long = System.currentTimeMillis(),  // ← 새 필드!
    val category: String = "일반",
    val isImportant: Boolean = false  // ← 새 필드!
)

@Database(entities = [Note::class], version = 3)
abstract class NoteDatabase : RoomDatabase() {
    abstract fun noteDao(): NoteDao

    companion object {
        val MIGRATION_1_2 = object : Migration(1, 2) {
            override fun migrate(db: SupportSQLiteDatabase) {
                db.execSQL("ALTER TABLE notes ADD COLUMN category TEXT NOT NULL DEFAULT '일반'")
            }
        }

        val MIGRATION_2_3 = object : Migration(2, 3) {
            override fun migrate(db: SupportSQLiteDatabase) {
                // 수정일 추가 (생성일과 동일하게 설정)
                db.execSQL(
                    "ALTER TABLE notes ADD COLUMN updatedAt INTEGER NOT NULL DEFAULT 0"
                )
                // 기존 데이터의 updatedAt을 createdAt으로 초기화
                db.execSQL(
                    "UPDATE notes SET updatedAt = createdAt"
                )

                // 중요도 추가 (기본값: false = 0)
                db.execSQL(
                    "ALTER TABLE notes ADD COLUMN isImportant INTEGER NOT NULL DEFAULT 0"
                )
            }
        }

        fun getDatabase(context: Context): NoteDatabase {
            return Room.databaseBuilder(context, NoteDatabase::class.java, "note_db")
                .addMigrations(MIGRATION_1_2, MIGRATION_2_3)  // 모든 마이그레이션!
                .build()
        }
    }
}

/*
최종 테이블:
