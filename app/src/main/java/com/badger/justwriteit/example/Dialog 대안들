// 3. DialogFragment (복잡한 Dialog에 권장)
// ========================================

/**
 * DialogFragment를 사용하는 이유:
 * 1. 생명주기 자동 관리
 * 2. 화면 회전시 자동 복원
 * 3. 복잡한 레이아웃 가능
 * 4. Fragment Manager로 관리
 */
class ConfirmDialogFragment : DialogFragment() {

    // 콜백 인터페이스
    interface ConfirmListener {
        fun onConfirm()
        fun onCancel()
    }

    private var listener: ConfirmListener? = null

    fun setListener(listener: ConfirmListener) {
        this.listener = listener
    }

    override fun onCreateDialog(savedInstanceState: Bundle?): Dialog {
        val title = arguments?.getString("title") ?: "확인"
        val message = arguments?.getString("message") ?: ""

        return MaterialAlertDialogBuilder(requireContext())
            .setTitle(title)
            .setMessage(message)
            .setPositiveButton("확인") { _, _ ->
                listener?.onConfirm()
            }
            .setNegativeButton("취소") { _, _ ->
                listener?.onCancel()
            }
            .create()
    }

    companion object {
        fun newInstance(title: String, message: String): ConfirmDialogFragment {
            return ConfirmDialogFragment().apply {
                arguments = Bundle().apply {
                    putString("title", title)
                    putString("message", message)
                }
            }
        }
    }
}

// DialogFragment 사용 예제
class UseDialogFragment : AppCompatActivity() {

    fun showDialogFragment() {
        val dialog = ConfirmDialogFragment.newInstance(
            title = "메모 삭제",
            message = "정말 삭제하시겠습니까?"
        )

        dialog.setListener(object : ConfirmDialogFragment.ConfirmListener {
            override fun onConfirm() {
                Toast.makeText(this@UseDialogFragment, "삭제됨", Toast.LENGTH_SHORT).show()
            }

            override fun onCancel() {
                Toast.makeText(this@UseDialogFragment, "취소됨", Toast.LENGTH_SHORT).show()
            }
        })

        dialog.show(supportFragmentManager, "ConfirmDialog")
    }
}

